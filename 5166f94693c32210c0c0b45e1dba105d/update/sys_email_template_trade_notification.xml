<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_email_template">
    <sys_email_template action="INSERT_OR_UPDATE">
        <active>true</active>
        <advanced>false</advanced>
        <body><![CDATA[<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        .header { background-color: #0073e6; color: white; padding: 15px; border-radius: 5px; }
        .content { padding: 20px; border: 1px solid #ddd; border-radius: 5px; margin-top: 10px; }
        .trade-details { background-color: #f9f9f9; padding: 15px; border-radius: 5px; margin: 10px 0; }
        .field { margin: 8px 0; }
        .label { font-weight: bold; color: #333; }
        .value { color: #666; }
        .footer { margin-top: 20px; font-size: 12px; color: #888; }
    </style>
</head>
<body>
    <div class="header">
        <h2>🔔 New Trade Record Alert</h2>
    </div>
    
    <div class="content">
        <p>A new trading position has been recorded in the Trade Book system.</p>
        
        <div class="trade-details">
            <h3>Trade Details:</h3>
            <div class="field">
                <span class="label">Trade Number:</span> 
                <span class="value">${trade_number}</span>
            </div>
            <div class="field">
                <span class="label">Stock Name:</span> 
                <span class="value">${stock_name}</span>
            </div>
            <div class="field">
                <span class="label">Buying Price:</span> 
                <span class="value">$${buying_price}</span>
            </div>
            <div class="field">
                <span class="label">Stop Loss:</span> 
                <span class="value">$${stop_loss}</span>
            </div>
            <div class="field">
                <span class="label">Trade Date:</span> 
                <span class="value">${trade_date}</span>
            </div>
        </div>
        
        <p><strong>Action Required:</strong> Please review this trade record in the Trade Book application and ensure all details are accurate.</p>
        
        <p><a href="${instance_url}/x_snc_trade_mana_0_trade_book_list.do" style="background-color: #0073e6; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">View Trade Book</a></p>
    </div>
    
    <div class="footer">
        <p>This is an automated notification from the Trade Management System.</p>
        <p>Generated on: ${current_date_time}</p>
    </div>
</body>
</html>]]></body>
        <category/>
        <description>Email template for new trade record notifications</description>
        <name>Trade Book - New Record Notification</name>
